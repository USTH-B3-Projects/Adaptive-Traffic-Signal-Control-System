<?xml version='1.0' encoding='utf-8'?>
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
  <input>
    <net-file value="../network/osm.fixed.net.xml" />
    <route-files value="../source/legacy_research.rou.xml" />
    <additional-files value="../network/osm.poly.xml.gz,output.add.xml" />
  </input>
  <output>
    <tripinfo-output value="../output/legacy_tripinfos.xml" />
    <statistic-output value="../output/legacy_stats.xml" />
  </output>
  <processing>
    <tls.actuated.jam-threshold value="30" />
    <lateral-resolution value="0.4" />
  </processing>
  <routing>
    <device.rerouting.adaptation-steps value="18" />
    <device.rerouting.adaptation-interval value="10" />
  </routing>
  <time>
    <step-length value="0.5" />
  </time>
  <report>
    <verbose value="true" />
    <duration-log.statistics value="true" />
    <no-step-log value="true" />
  </report>
  <gui_only>
    <gui-settings-file value="osm.view.xml" />
  </gui_only>
</sumoConfiguration>