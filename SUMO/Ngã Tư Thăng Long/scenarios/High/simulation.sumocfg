<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <input>
    <net-file value="../../network/thang_long.net.xml" />
    <route-files value="traffic.rou.xml" />
  </input>
  <time>
    <step-length value="0.1" />
  </time>
  <processing>
    <lateral-resolution value="0.325" />
    <collision.check-junctions value="true" />
    <collision.action value="warn" />
    <time-to-teleport value="-1" />
  </processing>
  <gui_only>
    <gui-settings-file value="../../config/osm.view.xml" />
  </gui_only>
  <output>
    <tripinfo-output value="../../output/High/seed42/tripinfos.xml" />
    <statistic-output value="../../output/High/seed42/stats.xml" />
  </output>
  <report>
    <no-step-log value="true" />
    <duration-log.statistics value="true" />
  </report>
</configuration>